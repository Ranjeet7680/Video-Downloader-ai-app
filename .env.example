# AI Video Tool - Environment Variables
# Copy this file to .env and fill in your values

# Server Config
PORT=3000
NODE_ENV=production

# YouTube Data API v3 Key
# Get your key at: https://console.cloud.google.com/apis/credentials
# Ensure "YouTube Data API v3" library is enabled in your Google Cloud Project.
YOUTUBE_API_KEY=your_youtube_api_key_here

# Meta / Instagram Graph API Configuration
# Get your credentials at: https://developers.facebook.com/apps/
# Option 1: Access Token directly
META_API_KEY=your_meta_access_token_here
META_ACCESS_TOKEN=
# Option 2: App ID & App Secret (Auto-assembled as App Access Token APP_ID|APP_SECRET)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here

# OpenAI API Key (for GPT video summary, reel highlights, subtitle generation)
OPENAI_API_KEY=your_openai_api_key_here

# Max file size in MB
MAX_FILE_SIZE=500

# Output directory
OUTPUT_DIR=./uploads
