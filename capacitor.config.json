{
  "appId": "com.ranjeet.videodownloader",
  "appName": "AI Video Downloader",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "*.vercel.app",
      "localhost",
      "*.youtube.com",
      "*.instagram.com"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "backgroundColor": "#0f0f1a",
    "overScrollMode": "never",
    "minWebViewVersion": 60,
    "appendUserAgent": "AIVideoDownloader/1.0"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#0f0f1a",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "dark",
      "backgroundColor": "#0f0f1a"
    }
  }
}
